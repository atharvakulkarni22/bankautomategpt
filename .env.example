# ---- Which LLM to use (switch provider by changing these lines) ----
# BAG_PROVIDER: anthropic | gemini | openai   (default: anthropic)
BAG_PROVIDER=anthropic
# BAG_MODEL: the model name for the provider above (required)
BAG_MODEL=claude-sonnet-5-5
# Optional, Claude only: thinking depth vs speed (low | medium | high | xhigh | max).
# "low" or "medium" keeps discovery steps quick so a run fits in its 180 s limit.
# BAG_EFFORT=low
# Only the key for your chosen provider is needed
ANTHROPIC_API_KEY=your-key-here
GEMINI_API_KEY=
OPENAI_API_KEY=
# Any other LLM (Ollama, LM Studio, OpenRouter, Groq...): set BAG_PROVIDER=openai
# and point this at its OpenAI-compatible URL. A key is optional for local servers.
# BAG_BASE_URL=http://localhost:11434/v1

# Local bank app URL
BANK_URL=http://127.0.0.1:5000

# Sign-on for the fake bank (pick your own values)
BANK_USER=teller1
BANK_PASSWORD=change-me

# Which environment variables the agent may type as {{secret:NAME}} (comma separated).
# Keep this list short: anything on it can be typed into a web page. Default shown.
# BAG_SECRET_NAMES=BANK_USER,BANK_PASSWORD

# Optional fault switches for the fake bank (leave unset for a well-behaved bank).
# They can also be set per visit with URL flags, e.g. /home?popup=1
# BANK_POPUP=1
# BANK_SLOW=3
# BANK_PERM=deny
# SESSION_TTL=60
